# ============================================
# VARIÁVEIS DE AMBIENTE - BIBLIOTECA DE ESTUDOS
# ============================================
# Este arquivo é um exemplo. Copie para .env (backend) e .env.local (frontend)
# e preencha com valores reais. NÃO versione arquivos .env.

# ============================================
# BACKEND
# ============================================

# Conexão com PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL="postgresql://usuario:senha@localhost:5432/biblioteca_estudos"

# URL do frontend para CORS
FRONTEND_URL="http://localhost:3001"

# Segredo para assinar tokens JWT (OBRIGATÓRIO - use pelo menos 32 bytes aleatórios)
# Gere com: openssl rand -base64 32 ou node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="substitua-por-um-segredo-aleatorio-real-de-pelo-menos-32-bytes"

# Porta do servidor (opcional, padrão: 3000)
PORT="3000"

# ============================================
# STORAGE S3-COMPATÍVEL (Cloudflare R2, AWS S3, MinIO)
# ============================================

# Nome do bucket
STORAGE_BUCKET="biblioteca-estudos"

# URL pública do storage (para construir URLs dos arquivos)
# Para R2: https://<bucket>.<account-id>.r2.cloudflarestorage.com
# Para MinIO local: http://localhost:9000/biblioteca-estudos
STORAGE_PUBLIC_URL="https://cdn.exemplo.com"

# Endpoint do serviço S3
# Para R2: https://<account-id>.r2.cloudflarestorage.com
# Para AWS S3: https://s3.amazonaws.com
# Para MinIO local: http://localhost:9000
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Região do storage
# Para R2: auto
# Para AWS S3: us-east-1, etc.
STORAGE_REGION="auto"

# Credenciais de acesso (OBRIGATÓRIO)
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Configurações de estilo de path
# Para R2: false
# Para MinIO: true
STORAGE_FORCE_PATH_STYLE="false"

# URLs assinadas (privadas)
STORAGE_SIGNED_URLS="true"

# Expiração das URLs assinadas em segundos (padrão: 3600 = 1 hora)
STORAGE_URL_EXPIRES_IN="3600"

# ============================================
# FRONTEND (arquivo .env.local)
# ============================================

# URL do backend (OBRIGATÓRIO - sem fallback em produção)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# URL base do storage para otimização de imagens (opcional)
NEXT_PUBLIC_STORAGE_URL="http://localhost:9000/biblioteca-estudos"


